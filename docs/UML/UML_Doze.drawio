        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass \&quot;SleepRecord (@Model)\&quot; as SleepRecord {\n  - id: UUID\n  - bedTime: Date\n  - wakeTime: Date\n  - energyLevel: Int\n  - note: String?\n  - createdAt: Date\n  - sleepLatencyMinutes: Int\n  + durationInHours: Double\n  + init(bedTime: Date, wakeTime: Date, energyLevel: Int, note: String?, sleepLatencyMinutes: Int)\n}\n\nclass \&quot;SleepViewModel (@Observable)\&quot; as SleepViewModel {\n  + selectedBedTime: Date\n  + selectedWakeTime: Date\n  + selectedEnergyLevel: Int\n  + selectedSleepLatency: Int\n  + noteInput: String\n  + calculatedTimes: [Date]\n  + computeWakeUpTimes()\n  + saveSleepRecord()\n  + scheduleWakeReminder()\n  + fetchMetrics()\n}\n\nclass SleepCalculator {\n  + calculateWakeUpTimes(from bedTime: Date, latencyMinutes: Int): [Date]\n  + calculateBedTimes(for targetWakeTime: Date, latencyMinutes: Int): [Date]\n  + calculateCompletedCycles(bedTime: Date, wakeTime: Date, latencyMinutes: Int): Double\n  + estimatedSleep(cycles: Int): Double\n}\n\nclass NotificationManager {\n  + scheduleWakeUpNotification(at: Date)\n  + cancelNotifications()\n}\n\nclass SleepMetrics {\n  + averageEnergyLevel(records: [SleepRecord]): Double\n  + averageSleepDuration(records: [SleepRecord]): Double\n  + averageSleepLatency(records: [SleepRecord]): Double\n  + logForDay(date: Date, in records: [SleepRecord]): SleepRecord?\n  + allLogs(records: [SleepRecord]): [SleepRecord]\n}\n\nSleepViewModel --&gt; SleepRecord\nSleepViewModel --&gt; SleepCalculator\nSleepViewModel --&gt; NotificationManager\nSleepViewModel --&gt; SleepMetrics\nSleepCalculator ..&gt; NotificationManager\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MtIGtoiNCwBSoYZU_VZg-210">
